- var page = 'additional-academic-projects'
- var pageTitle = 'Additional Academic Projects - Abhiraj Smit'

doctype html
html(lang='en')

    include includes/head.pug

    body#page-top

        include includes/nav.pug

        // Page Content
        .container-fluid.p-0

            section#additional-academic-projects.resume-section
                .resume-section-content
                    h2.mb-5 Additional Academic Projects

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-4
                        .flex-grow-1
                            h3.mb-0 Music Service Website
                            ul.mb-0.mt-2
                                li Developed a music streaming website on the college LAN as a fun project for college friends, allowing users to share music and create personalized playlists.
                                li Designed and implemented RESTful back-end APIs to support song retrieval and downloads.
                                li Hosted the application on a personal IP address over the college network, enabling college friends to access and share a centralized music library and playlists.
                        .flex-shrink-0
                            span.text-primary Feb 2015 - Apr 2015

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-4
                        .flex-grow-1
                            h3.mb-0 Networking and Website Designing
                            .subheading.mb-2 Netcamp Summer Training
                            ul.mb-2
                                li Configured Samba file sharing between Red Hat Linux running on VMware and Windows, including file-sharing and permission management.
                                li Configured mail transfer services using Webmin, gaining hands-on experience with Linux server administration and GUI-based system configuration.
                            p.mb-0 #[a(href='assets/img/certificates/netcamp-network-management-certificate.jpg', target='_blank', rel='noopener') View Certificate] &mdash; Netcamp Solutions Pvt. Ltd.
                        .flex-shrink-0
                            span.text-primary Jan 2015 - Feb 2015

                    .d-flex.flex-column.flex-md-row.justify-content-between
                        .flex-grow-1
                            h3.mb-0 Airline Reservation System (ARS)
                            ul.mb-2.mt-2
                                li Developed an airline booking and management website with core functionality including ticket booking and cancellation, upcoming-flight enquiries, fare lookup for flights over the next two weeks, PNR status checking, and online check-in.
                                li Implemented additional supporting functionality for managing the airline booking workflow and user interactions.
                                li Built the application on a WAMP server using PHP, MySQL, HTML, CSS, JavaScript, and AJAX.
                            p.mb-0 #[a(href='assets/img/certificates/hp-ars-project-certificate.png', target='_blank', rel='noopener') View Project Certificate] &mdash; Hewlett-Packard India Sales Pvt. Ltd.
                        .flex-shrink-0
                            span.text-primary May 2014 - Jun 2014

        // Bootstrap core JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js')
        script(src='https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.bundle.min.js')

        // Third party plugin JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js')

        // Core theme JS
        script(src='js/scripts.js')
