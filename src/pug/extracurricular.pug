- var page = 'extracurricular'
- var pageTitle = 'Extra Curricular Activities - Abhiraj Smit'

doctype html
html(lang='en')

    include includes/head.pug

    body#page-top

        include includes/nav.pug

        // Page Content
        .container-fluid.p-0

            section#extracurricular.resume-section
                .resume-section-content
                    h2.mb-5 Extra Curricular Activities
                    p.text-muted.mb-5
                        a.js-scroll-trigger(href='index.html') &larr; Back to full resume
                    ul.fa-ul.mb-0
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Organized events in Bitotsav '15 and Vertechx '15 (Blitzkrieg and Reverse Engineering).
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Hobbies: Movies, Anime, Chess, Badminton, Cricket, Computer games and Table Tennis.

        // Bootstrap core JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js')
        script(src='https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.bundle.min.js')

        // Third party plugin JS
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js')

        // Core theme JS
        script(src='js/scripts.js')
