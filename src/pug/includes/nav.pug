- var subPages = ['education', 'awards', 'extracurricular', 'responsibility']
- var onSubPage = (typeof page !== 'undefined' && subPages.indexOf(page) !== -1)
- var home = onSubPage ? 'index.html' : ''
- var moreLabels = { education: 'Education', awards: 'Awards & Achievements', extracurricular: 'Activities', responsibility: 'Responsibility' }
- var moreLabel = onSubPage ? moreLabels[page] : 'More'
- var onEducation = (typeof page !== 'undefined' && page === 'education')

nav#sideNav.navbar.navbar-expand-lg.navbar-light.bg-white.fixed-top
    a.navbar-brand.js-scroll-trigger(href=home + '#page-top')
        span.d-block.d-lg-none Abhiraj Smit
        span.d-none.d-lg-block
            img.img-fluid.img-profile.rounded-circle.mx-auto.mb-2(src='assets/img/profile.jpg', alt='')
    button.navbar-toggler(type='button', data-toggle='collapse', data-target='#navbarSupportedContent', aria-controls='navbarSupportedContent', aria-expanded='false', aria-label='Toggle navigation')
        span.navbar-toggler-icon
    #navbarSupportedContent.collapse.navbar-collapse
        ul.navbar-nav
            li.nav-item
                a.nav-link.js-scroll-trigger(href=home + '#about') About
            li.nav-item
                a.nav-link.js-scroll-trigger(href=home + '#experience') Experience
            li.nav-item
                a.nav-link.js-scroll-trigger(href=home + '#skills') Skills
            li.nav-item
                a.nav-link.js-scroll-trigger(href=home + '#projects') Projects
            li.nav-item
                a.nav-link.js-scroll-trigger(href=home + '#certifications') Certifications
            li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href='#', id='moreDropdown', role='button', data-toggle='dropdown', aria-haspopup='true', aria-expanded='false', class=onSubPage ? 'active' : '')= moreLabel
                .dropdown-menu(aria-labelledby='moreDropdown')
                    a.dropdown-item.js-scroll-trigger(href='education.html#page-top', class=page === 'education' ? 'active' : '') Education
                    a.dropdown-item.js-scroll-trigger(href='awards.html', class=page === 'awards' ? 'active' : '') Awards &amp; Achievements
                    a.dropdown-item.js-scroll-trigger(href='extracurricular.html', class=page === 'extracurricular' ? 'active' : '') Extra Curricular Activities
                    a.dropdown-item.js-scroll-trigger(href='responsibility.html', class=page === 'responsibility' ? 'active' : '') Responsibility

            if onEducation
                li.nav-item
                    a.nav-link.sidenav-subnav-link.js-scroll-trigger(href='education.html#page-top') Overview
                li.nav-item
                    a.nav-link.sidenav-subnav-link.js-scroll-trigger(href='education.html#edu-stonybrook') Stony Brook University
                li.nav-item
                    a.nav-link.sidenav-subnav-link.js-scroll-trigger(href='education.html#edu-bitmesra') BIT Mesra
                li.nav-item
                    a.nav-link.sidenav-subnav-link.js-scroll-trigger(href='education.html#edu-aissce') AISSCE
                li.nav-item
                    a.nav-link.sidenav-subnav-link.js-scroll-trigger(href='education.html#edu-aisse') AISSE
