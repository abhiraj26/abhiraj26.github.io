doctype html
html(lang='en')

    include includes/head.pug

    body#page-top

        include includes/nav.pug

        // Page Content
        .container-fluid.p-0

            section#responsibility.resume-section
                .resume-section-content
                    h2.mb-5 Responsibility

                    h3.mb-0 Institute of Engineering and Technology (IET), BIT Mesra
                    .subheading.mb-3 August 2015 - May 2017 &middot; 1 yr 9 mos

                    .org-roles.border-left.pl-4.ml-1
